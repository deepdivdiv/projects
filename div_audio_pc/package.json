{
  "name": "div-audio-pc",
  "productName": "DIV AUDIO APP",
  "version": "1.6.7",
  "description": "DIV AUDIO APP for Windows",
  "main": "main.js",
  "private": true,
  "author": "DIV AUDIO",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "dist": "electron-builder --win",
    "e2e": "node test/e2e.js",
    "port": "node tools/port-www.js"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0"
  },
  "build": {
    "appId": "com.snet.divaudio.pc",
    "productName": "DIV AUDIO APP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "www/**",
      "build/icon.png"
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DIV_AUDIO_APP_Setup_${version}.${ext}",
      "shortcutName": "DIV AUDIO APP"
    },
    "portable": {
      "artifactName": "DIV_AUDIO_APP_Portable_${version}.${ext}"
    }
  }
}
